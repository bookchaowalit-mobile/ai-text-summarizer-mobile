<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-android;net8.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>com.bookchaowalit.textsummarizer</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>Text Summarizer</ApplicationTitle>
    <ApplicationIdGuid>a1b2c3d4-e5f6-7890-abcd-ef1234567890</ApplicationIdGuid>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.*" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- core library and tests are separate projects; keep them out of the app's default globs -->
    <Compile Remove="src/**;tests/**" />
    <None Remove="src/**;tests/**" />
    <MauiXaml Remove="src/**;tests/**" />
    <ProjectReference Include="src/TextSummarizer.Core/TextSummarizer.Core.csproj" />
  </ItemGroup>
</Project>
